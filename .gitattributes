# Git attributes — line ending normalization and merge strategies

# Default: LF line endings (matches .editorconfig)
* text=auto eol=lf

# Java files — LF
*.java   text eol=lf
*.xml    text eol=lf

# Web files — LF
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.mjs    text eol=lf
*.vue    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf

# Markdown — LF
*.md     text eol=lf

# Shell scripts — LF
*.sh     text eol=lf
*.bash   text eol=lf

# Binary files — no line ending conversion
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    text eol=lf
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary
*.zip    binary
*.tar    binary
*.gz     binary

# Makefile — tabs
Makefile text eol=lf

# Dockerfile — LF
Dockerfile* text eol=lf

# Config files — LF
*.env    text eol=lf
*.ini    text eol=lf
*.conf   text eol=lf

# Ensure JSON config files are mergeable
package-lock.json merge=ours
package.json merge=ours