# ──────────────────────────────────────────────────────────────
# .gitignore — eCommerce project
# Java/Maven, Node.js, Docker, IDEs, OS files
# ──────────────────────────────────────────────────────────────

# ─── Java / Maven ───────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

# ─── Node.js ─────────────────────────────────────────────────
node_modules/
**/node_modules/
dist/
build/
.output/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnpm-store/
*.tsbuildinfo

# ─── Environment files (never commit secrets) ───────────────
.env
.env.local
.env.*.local
secrets.json
!.env.example
!.env.development

# ─── Test output ─────────────────────────────────────────────
test-results/
.nyc_output/
*.lcov
coverage/
playwright-report/
playwright/.cache/
test-results/.last-run.json
blob-report/

# ─── Docker ──────────────────────────────────────────────────
docker-compose.override.*.yml
!docker/compose/docker-compose.yml
!docker/compose/docker-compose.override.yml

# ─── IDE: VS Code ───────────────────────────────────────────
.vscode/*
!src/frontend/spa/.vscode/
!src/frontend/spa/.vscode/extensions.json
!src/frontend/spa/.vscode/settings.json

# ─── IDE: JetBrains (IntelliJ, WebStorm) ─────────────────────
.idea/
*.iml
*.ipr
*.iws

# ─── OS: Windows ─────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ─── OS: macOS ───────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# ─── OS: Linux ────────────────────────────────────────────────
*~
.directory
.Trash-*

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
*.pid
*.seed
*.pid.lock

# ─── Temporary files ─────────────────────────────────────────
tmp/
temp/
*.bak
*.swp
*.swo

# ─── Build artifacts ─────────────────────────────────────────
src/backend/target/
src/frontend/spa/dist/
src/frontend/spa/node_modules/
src/frontend/spa/.vite/
src/frontend/spa/test-results/
tests/e2e/node_modules/
tests/e2e/test-results/
tests/e2e/playwright-report/

# ─── Generated Documentation ──────────────────────────────────
*.generated.md